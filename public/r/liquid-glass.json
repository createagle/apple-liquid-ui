{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "liquid-glass",
  "title": "Apple Liquid Glass Foundation",
  "description": "Apple macOS 27 & iOS 27 system color tokens, @liqui-design/glass refraction tokens, and Motion spring physics.",
  "dependencies": [
    "@liqui-design/glass",
    "motion"
  ],
  "files": [
    {
      "path": "lib/liquid-motion.ts",
      "content": "import type { Transition } from \"motion/react\"\n\n/**\n * Shared Motion spring presets tuned to Apple macOS 27 & iOS 27 Liquid Glass physics.\n */\nexport const LIQUID_SPRINGS = {\n  /** Crisp desktop macOS tactile press */\n  macosPress: {\n    type: \"spring\",\n    stiffness: 520,\n    damping: 32,\n    mass: 0.65,\n  },\n  /** Elastic iOS 27 Liquid Glass gel-squish press and rebound */\n  iosPress: {\n    type: \"spring\",\n    stiffness: 380,\n    damping: 22,\n    mass: 0.75,\n  },\n  /** Silky pointer-tracking specular highlight glide */\n  specular: {\n    stiffness: 340,\n    damping: 28,\n    mass: 0.35,\n  },\n  /** Smooth layoutId capsule morphing (Tabs, Segmented Controls, Dock) */\n  morph: {\n    type: \"spring\",\n    stiffness: 420,\n    damping: 30,\n    mass: 0.8,\n  },\n} as const satisfies Record<string, Transition>\n\nexport const LIQUID_PRESS_SCALE = {\n  macos: 0.97,\n  ios: 0.935,\n} as const\n",
      "type": "registry:lib"
    }
  ],
